# QuizForge backend environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Database --------------------------------------------------------------
# Neon PostgreSQL connection string (primary / production).
# Get this from your Neon project dashboard -> Connection Details.
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- Auth --------------------------------------------------------------
# Any long, random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret

# --- CORS --------------------------------------------------------------
# The URL(s) of your deployed frontend, comma-separated if more than one.
# Example for local dev with a static server on port 5500:
FRONTEND_URL=http://localhost:5500

# --- Flask --------------------------------------------------------------
# "development" or "production"
FLASK_ENV=development

# Port the app binds to (Render and most PaaS providers set this for you)
PORT=5000
